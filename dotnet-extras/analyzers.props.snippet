<!-- 1) Add inside the <PropertyGroup> of Directory.Build.props: -->

    <!-- Built-in .NET analyzers incl. security rules. Disable per build with -p:DisableExtraAnalyzers=true -->
    <AnalysisLevel Condition="'$(DisableExtraAnalyzers)' != 'true'">latest-recommended</AnalysisLevel>

<!-- 2) Add before </Project> in Directory.Packages.props (requires central package management): -->

  <!-- Solution-wide static analysis. Disable per build with -p:DisableExtraAnalyzers=true -->
  <ItemGroup Condition="'$(DisableExtraAnalyzers)' != 'true'">
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.28.0.143324" />
  </ItemGroup>

<!-- 3) Add to .editorconfig under [*.cs] — demote noisy low-value rules so warnings stay meaningful: -->
<!--
# CA1707: underscores in identifiers — conflicts with xUnit test naming convention
# CA1848: LoggerMessage delegates — perf micro-optimization, not worth a codebase-wide refactor
dotnet_diagnostic.CA1707.severity = suggestion
dotnet_diagnostic.CA1848.severity = suggestion
-->

<!-- 4) IMPORTANT: if CI runs `dotnet format --verify-no-changes`, split it into
     `dotnet format whitespace --verify-no-changes` and
     `dotnet format style --verify-no-changes --severity info`
     — otherwise the gate fails on every pre-existing analyzer finding. -->
