#!/bin/bash
# Deterministic verification gate — the final vote on any change.
# Green here = done; anything else = not done. No self-assessment overrides this.
# EDIT: replace each step with this project's real commands (same ones CI runs),
# then rename to verify.sh, chmod +x, and reference it from AGENTS.md's
# definition of done.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "[verify] 0/3 restore locked dependencies (same as CI — catches lock-file drift locally)"
# .NET:  dotnet restore --locked-mode      (requires RestorePackagesWithLockFile)
# TS:    pnpm install --frozen-lockfile
<RESTORE COMMAND>

echo "[verify] 1/3 build"
# .NET:  dotnet build --configuration Release --no-incremental --no-restore
# TS:    npm run build && npx tsc --noEmit
<BUILD COMMAND>

# OPTIONAL — warning ratchet (count may go down, never up; baseline tightens
# itself). See the .NET reference implementation for the pattern: capture the
# build's warning count, compare against scripts/warnings-baseline.txt, fail
# if higher, rewrite baseline if lower.

echo "[verify] 2/3 format/lint gate"
# .NET:  dotnet format whitespace --verify-no-changes && dotnet format style --verify-no-changes --severity info
# TS:    npx prettier --check . && npx eslint .
<FORMAT COMMAND>

echo "[verify] 3/3 tests (same filter as CI)"
# .NET:  dotnet test --configuration Release --no-build --filter "Category!=ExternalE2E"
# TS:    npx vitest run
<TEST COMMAND>

echo "[verify] ALL GREEN"
