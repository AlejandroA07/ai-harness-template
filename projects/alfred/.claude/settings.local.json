{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet run --project src/Alfred.Api:*)",
      "Bash(dotnet ef migrations:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run dev:*)",
      "Bash(pnpm install:*)",
      "Bash(scripts/verify.sh)",
      "Bash(./scripts/verify.sh)"
    ],
    "defaultMode": "acceptEdits"
  },
  "_harness_mode": "auto",
  "enabledMcpjsonServers": [
    "playwright",
    "context7"
  ]
}
