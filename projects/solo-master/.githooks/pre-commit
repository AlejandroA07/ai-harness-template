#!/bin/bash
# Scan staged changes for secrets. Enable once per clone with:
# git config core.hooksPath .githooks

# Branch names become public history (PRs, merge commits) — block AI-tool prefixes.
branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
case "$branch" in
  codex/*|claude/*|copilot/*|cursor/*|agent/*|ai/*)
    echo "[pre-commit] BLOCKED: branch '$branch' carries an AI-tool prefix."
    echo "[pre-commit] Rename it first: git branch -m feature/${branch#*/}"
    exit 1
    ;;
esac

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] BLOCKED: gitleaks is required but not installed."
  echo "[pre-commit] Install it with: brew install gitleaks"
  exit 1
fi

if ! gitleaks git --pre-commit --staged --redact -v; then
  echo
  echo "[pre-commit] BLOCKED: gitleaks found a potential secret in staged changes."
  echo "[pre-commit] Remove it and use .NET user secrets or environment variables."
  exit 1
fi

exit 0
